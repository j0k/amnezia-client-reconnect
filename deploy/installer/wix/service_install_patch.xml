<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
    <CPackWiXFragment Id="CM_CP_AmneziaVPN.AmneziaVPN_service.exe">
        <ServiceInstall
                Id="AmneziaServiceInstall"
                Name="AmneziaVPN-service"
                DisplayName="AmneziaVPN Service"
                Description="Service for AmneziaVPN"
                Start="auto"
                Type="ownProcess"
                ErrorControl="normal"
                Vital="no">
            <ServiceDependency Id="BFE" />
            <ServiceDependency Id="nsi" />
        </ServiceInstall>
        <ServiceControl
                Id="AmneziaServiceControl"
                Name="AmneziaVPN-service"
                Start="install"
                Stop="both"
                Remove="uninstall"
                Wait="yes" />
        <!-- The daemon registers the split-tunnel kernel driver from its own folder. A
             registration left by another install folder (official client) points at a
             deleted .sys and breaks split tunneling, so drop it on install and uninstall. -->
        <ServiceControl
                Id="AmneziaSplitTunnelDriverControl"
                Name="AmneziaVPNSplitTunnel"
                Stop="both"
                Remove="both"
                Wait="no" />
    </CPackWiXFragment>
</CPackWiXPatch>
