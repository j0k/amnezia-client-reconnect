<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
    <!-- CPack's WiX template looks up the previous product's InstallLocation in the registry and
         reuses it as INSTALL_ROOT on a major upgrade. Upgrading over the official client (same
         UpgradeCode) therefore kept installing into C:\Program Files\AmneziaVPN. Always use the
         fork's own folder; the user can still change it with "Browse" afterwards. -->
    <CPackWiXFragment Id="#PRODUCT">
        <SetProperty Id="INSTALL_ROOT" Value="[ProgramFiles64Folder]AmneziaVPN_Reconnect\" After="AppSearch" Sequence="both" />
    </CPackWiXFragment>
</CPackWiXPatch>
